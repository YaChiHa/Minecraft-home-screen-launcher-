<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.blockhome.ui.BlockyBackgroundView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/content_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="monospace"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:shadowColor="#CC000000"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="1"
                android:textColor="#FFFFFFFF"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:gravity="center"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_panel"
                android:padding="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/settings_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_button"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="@string/settings"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/set_default_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="@string/set_default"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/drawer_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="@string/app_drawer"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingBottom="20dp"
                android:text="@string/blockhome_settings"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/choose_background_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="@string/choose_background"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/reset_background_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="@string/reset_background"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Button
    android:id="@+id/sound_toggle_button"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_button"
    android:fontFamily="monospace"
    android:stateListAnimator="@null"
    android:text="@string/sound_on"
    android:textColor="#FFFFFFFF"
    android:textSize="14sp"
    android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
    android:id="@+id/back_settings_button"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/bg_button"
    android:fontFamily="monospace"
    android:stateListAnimator="@null"
    android:text="@string/back"
    android:textColor="#FFFFFFFF"
    android:textSize="14sp"
    android:textStyle="bold" /> 
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_search"
                android:fontFamily="monospace"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FFC9B29A"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />
           <Button
    android:id="@+id/close_drawer_button"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_button"
    android:fontFamily="monospace"
    android:stateListAnimator="@null"
    android:text="@string/close_drawer"
    android:textColor="#FFFFFFFF"
    android:textSize="15sp"
    android:textStyle="bold" /> 
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
